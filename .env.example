# =============================================================================
# SmarTel — Telegram Business Managed AI Bot — environment configuration
# =============================================================================
# Copy this file to ".env" and fill in the values, OR just run `python main.py`
# once and the first-launch wizard will create ".env" for you.
#
# Only three things are really required to get started:
#   1. BOT_TOKEN           (from @BotFather)
#   2. an AI provider key  (AI_API_KEY, or set it later from Telegram with /ai)
#   3. nothing else — send "/start <claim-code>" to the bot to become the owner
#
# Everything else has a sensible default and can be changed later from inside
# Telegram (/ai, /settings, /faq, /mode). Behavioral settings live in the SQLite
# `settings` table; the DEFAULT_* / AI_* values below only SEED that table the
# first time the database is created.
# =============================================================================

# --- Required: identity & secrets -------------------------------------------

# Bot token from @BotFather (format: 123456789:AA....). KEEP SECRET.
BOT_TOKEN=

# Your personal Telegram numeric user ID (the bot OWNER / admin).
# OPTIONAL: leave blank and the bot prints a one-time CLAIM CODE in the terminal
# at startup — send "/start <code>" to the bot in Telegram and you become the
# owner. Set ALLOW_OWNER_CLAIM=false to forbid claiming entirely.
OWNER_USER_ID=
ALLOW_OWNER_CLAIM=true

# --- AI provider ------------------------------------------------------------
# Which engine writes the replies. Pick one of:
#
#   FREE (no credit card, no balance top-up):
#     google        Gemini — most generous free tier, a Google account is enough
#     groq          very fast, free with an email only
#     cerebras      ~1M free tokens/day
#     openrouter    one key, many models (use a model name ending in ":free")
#     mistral       free "Experiment" plan (phone verification, no card)
#     nvidia        free signup credits (build.nvidia.com)
#     sambanova     free developer key
#     huggingface   free with an HF token, small monthly allowance
#     pollinations  no key at all — slow, best effort, good for a first test
#     ollama        free and private, runs on your own machine
#     lmstudio      free and private, runs on your own machine
#
#   PAID (the account must have credit — a ChatGPT/Claude subscription is NOT
#   API credit, which is the usual reason a brand-new key "does not work"):
#     openai | anthropic | deepseek | xai | together
#
#   Other: custom (any OpenAI-compatible URL) | codex (your ChatGPT plan via CLI)
#
# You can also leave these blank and configure everything from Telegram with
# /ai — or /freeai for the free shortlist.
AI_PROVIDER=openai

# The provider's API key. Per-provider alternatives are also honoured:
#   OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, GROQ_API_KEY,
#   CEREBRAS_API_KEY, OPENROUTER_API_KEY, DEEPSEEK_API_KEY, MISTRAL_API_KEY,
#   XAI_API_KEY, TOGETHER_API_KEY, NVIDIA_API_KEY, SAMBANOVA_API_KEY, HF_TOKEN
# A key set in .env always wins over the encrypted copy stored by /ai.
AI_API_KEY=

# Optional model override (blank = the provider's default, e.g. gpt-4.1-mini for
# openai, gemini-2.5-flash for google, llama-3.3-70b-versatile for groq,
# meta-llama/llama-3.3-70b-instruct:free for openrouter).
# Model catalogues change often: in Telegram use /ai -> "Load models from the
# provider" to see the exact names your key can run.
AI_MODEL=

# Optional custom base URL. Required for AI_PROVIDER=custom, useful for
# ollama (http://localhost:11434/v1), lmstudio (http://localhost:1234/v1) and
# omniroute (http://localhost:20128/v1), or for any OpenAI-compatible
# gateway/proxy you run yourself.
AI_BASE_URL=

# --- OmniRoute (self-hosted gateway, no AI key inside the bot) ---------------
# AI_PROVIDER=omniroute sends every reply to a self-hosted OmniRoute instance
# (https://github.com/diegosouzapw/OmniRoute). You never paste an AI key into
# the bot: OmniRoute holds the provider accounts and does routing/fallback.
# Default endpoint is http://localhost:20128/v1.
#   - plain install  : run OmniRoute on the same machine as the bot
#   - Docker         : use http://host.docker.internal:20128/v1 (see README)
# Override the address when OmniRoute is not on the default host/port:
OMNIROUTE_BASE_URL=
# Only needed when your OmniRoute sets REQUIRE_API_KEY=true (its default is
# false, i.e. the local /v1 endpoint accepts requests without a key):
OMNIROUTE_API_KEY=

# --- Legacy AI keys (still supported) ---------------------------------------
# OPENAI_API_KEY is used for provider "openai" when AI_API_KEY is empty.
# OPENAI_BASE_URL = a custom OpenAI-compatible endpoint (equivalent to
# AI_PROVIDER=custom + AI_BASE_URL). If the endpoint needs no key, leave the
# key blank.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# MODEL_BACKEND=codex generates replies through your ChatGPT plan via the Codex
# CLI ("Sign in with ChatGPT") instead of an API key. Requires the Codex CLI
# installed and `codex login` completed. Leave as-is for normal API use.
MODEL_BACKEND=openai

# --- Codex backend tunables (only used when MODEL_BACKEND=codex) --------------
# Optional model override passed to `codex exec -m` (blank = Codex's default).
CODEX_MODEL=
# Path/name of the Codex binary if not on PATH (default: "codex").
CODEX_BIN=
# Per-reply timeout in seconds (default 180).
CODEX_EXEC_TIMEOUT=
# Advanced: override the flags passed to `codex exec` for your Codex version.
# Default: --skip-git-repo-check --sandbox read-only
# (the bot auto-retries with a minimal set if your CLI rejects a flag).
CODEX_EXEC_ARGS=

# --- Optional: at-rest encryption for stored API keys ------------------------
# If set (and the `cryptography` package is installed), the copy of the API key
# saved in the database is encrypted with this Fernet key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, the at-rest copy falls back to plain-local storage.
SMARTEL_FERNET_KEY=

# --- Behavioral defaults (seed the settings table on first run only) ---------

# Default chat model used for replies.
DEFAULT_MODEL=gpt-4.1-mini

# Whether automatic replies are enabled by default (true/false).
# Shipping default is false (safe): nothing is sent until you turn it on.
DEFAULT_AUTO_REPLY=false

# Whether approval-before-send mode is enabled by default (true/false).
# Shipping default is true (safe): replies are proposed to you for approval.
DEFAULT_APPROVAL_MODE=true

# --- Paths & tunables (sensible defaults; usually leave as-is) ----------------

# SQLite database file path.
DB_PATH=storage/smartel.db

# Directory for uploaded knowledge-base files.
UPLOADS_DIR=storage/uploads

# Reserved directory (vector store).
VECTOR_STORE_DIR=storage/vector_store

# Number of worker threads for handling Telegram updates.
WORKER_THREADS=4

# Debug mode (true/false). When true, logs are more verbose and MAY include
# message content. Keep false in production.
DEBUG=false
